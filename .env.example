# Copy to .env and fill in your own Supabase project values.
# Server-side
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_URL=https://your-project-id.supabase.co

# Client-side (exposed in the browser bundle by design)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Server-only secret — used by src/integrations/supabase/client.server.ts.
# NEVER commit a real value. Set it in your host's env settings.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
